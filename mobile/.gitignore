# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

dist/
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Local env overrides (keep .env.example tracked)
.env
.env.local

# typescript
*.tsbuildinfo


# Android build output / local state (the android/ project itself IS committed)
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/.cxx/
android/local.properties
android/captures/
android/*.iml
*.hprof
