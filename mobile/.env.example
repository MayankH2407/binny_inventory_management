# Backend API base URL. The app defaults to the TEST server; override it at BUNDLE TIME
# with the API_URL environment variable (there is no .env file loader):
#
#   API_URL=https://binnyfootwear.basiq360.com/api/v1 npm run build:apk     # LIVE
#   API_URL=http://10.0.2.2:3001/api/v1 npm run android                     # local backend, Android emulator
#   API_URL=http://<your-lan-ip>:3001/api/v1 npm run android                # local backend, physical device on LAN
#
# Switching targets: run `cd android && ./gradlew clean` first — Gradle won't notice an env change.
# Default (TEST): https://srv1409601.hstgr.cloud/binny/api/v1
API_URL=
